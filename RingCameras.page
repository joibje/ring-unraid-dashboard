<?php
$snapshotDir = "/mnt/user/appdata/ring-unraid/snapshots";
$cameras = [];
if (is_dir($snapshotDir)) {
    foreach (glob("$snapshotDir/*.jpg") as $file) {
        $name = basename($file, ".jpg");
        $timestampFile = "$snapshotDir/{$name}_timestamp.txt";
        $timestamp = file_exists($timestampFile) ? trim(file_get_contents($timestampFile)) : "";
        $cameras[] = [
            "name" => str_replace("_", " ", $name),
            "file" => $file,
            "timestamp" => $timestamp
        ];
    }
}
?>
<style>
.rc{display:flex;flex-wrap:wrap;gap:12px;padding:10px}
.rc-cam{flex:1;min-width:300px;max-width:600px;position:relative}
.rc-cam img{width:100%;display:block;border-radius:4px}
.rc-label{position:absolute;bottom:0;left:0;right:0;padding:6px 10px;background:rgba(0,0,0,.6);display:flex;justify-content:space-between;font-size:12px;border-radius:0 0 4px 4px}
.rc-name{color:#fff;font-weight:bold}
.rc-time{color:#aaa}
</style>
<div class="rc">
<?php if (empty($cameras)): ?>
<p style="color:#999">No Ring cameras found. <a href="http://<?=$_SERVER['SERVER_ADDR']?>:55123" target="_blank">Open ring-mqtt web UI</a> to authenticate.</p>
<?php else: foreach ($cameras as $cam): ?>
<div class="rc-cam">
<img src="data:image/jpeg;base64,<?=base64_encode(file_get_contents($cam['file']))?>" alt="<?=htmlspecialchars($cam['name'])?>">
<div class="rc-label"><span class="rc-name"><?=htmlspecialchars($cam['name'])?></span><span class="rc-time"><?=htmlspecialchars($cam['timestamp'])?></span></div>
</div>
<?php endforeach; endif; ?>
</div>
